start: "record" field+ "end" ";"?

field: dml_type vector_suffix? CNAME field_default? ";"     -> scalar_field
     | "record" field+ "end" CNAME ";"                       -> nested_field
     | "record" "[" CNAME "]" field+ "end" CNAME ";"         -> nested_vector_field
     | "union" field+ "end" CNAME ";"                        -> union_field
     | conditional_clause                                    -> conditional_field

conditional_clause: "if" "(" cond_expr ")" branch_field cond_more*
cond_more: "else" "if" "(" cond_expr ")" branch_field   -> cond_elif
        | "else" branch_field                            -> cond_else
// branch_field is field minus the conditional alternative — disallowing nested
// conditionals here keeps Earley's parse unambiguous around `else` in TC-018.
branch_field: dml_type vector_suffix? CNAME field_default? ";"     -> scalar_field
            | "record" field+ "end" CNAME ";"                       -> nested_field
            | "record" "[" CNAME "]" field+ "end" CNAME ";"         -> nested_vector_field
            | "union" field+ "end" CNAME ";"                        -> union_field

cond_expr: CNAME "==" cond_value
cond_value: ESCAPED_STRING -> cond_value_str
          | SIGNED_NUMBER  -> cond_value_num

vector_suffix: "[" INT "]"     -> vector_fixed
             | "[" CNAME "]"   -> vector_var

field_default: "=" default_literal

default_literal: ESCAPED_STRING -> default_string
               | SIGNED_NUMBER  -> default_number

dml_type: decimal_t
        | packed_decimal_t
        | zoned_decimal_t
        | integer_t
        | real_t
        | string_t
        | void_t
        | date_t
        | datetime_t

decimal_t: "decimal" "(" decimal_args ")"
packed_decimal_t: "packed_decimal" "(" decimal_args ")"
zoned_decimal_t: "zoned_decimal" "(" decimal_args ")"
decimal_args: INT ("," INT)?                                                   -> decimal_fixed
            | ESCAPED_STRING ("," ESCAPED_STRING)? ("," null_indicator)?       -> decimal_str_form

integer_t: "integer" "(" INT ")"

real_t: "real" "(" ESCAPED_STRING ("," ESCAPED_STRING)? ")"

string_t: "string" "(" string_args ")"
string_args: INT                                                  -> string_fixed
           | INT "," ESCAPED_STRING ("," null_indicator)?         -> string_hybrid
           | ESCAPED_STRING ("," null_indicator)?                 -> string_delim

null_indicator: "null" "(" ESCAPED_STRING ")"

void_t: "void" "(" void_args ")"
void_args: INT                   -> void_fixed
         | ESCAPED_STRING        -> void_delim

date_t: "date" "(" ESCAPED_STRING ")" ("(" ESCAPED_STRING ")")?
datetime_t: "datetime" "(" ESCAPED_STRING ")" ("(" ESCAPED_STRING ")")?

COMMENT: /\/\*(.|\n)*?\*\//
       | /\/\/[^\n]*/

%import common.CNAME
%import common.INT
%import common.SIGNED_NUMBER
%import common.ESCAPED_STRING
%import common.WS
%ignore WS
%ignore COMMENT
